{
  "name": "webmesh-studio",
  "version": "3.0.0",
  "private": true,
  "description": "A modular browser-based finite element pre/post processor with local CAD meshing",
  "scripts": {
    "start": "python3 server.py",
    "test": "node --test tests/*.test.cjs",
    "test:cad": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "build:meshers": "zig build",
    "test:meshers": "zig build test"
  }
}
